# ============================================
# Application
# ============================================
APP_NAME=MedBook API
# APP_ENV: "development" or "production"
APP_ENV=production
# APP_DEBUG: set to "true" only for local development.
# In production keep it "false" to avoid leaking SQL and sensitive data into logs.
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ============================================
# Security / JWT
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
# 60 minutes is a demo convenience. OWASP recommends 15 minutes for production.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_USER=medbook
POSTGRES_PASSWORD=medbook
POSTGRES_DB=medbook
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# ============================================
# Cache (TTL in seconds)
# ============================================
CACHE_TTL_DOCTORS=300
CACHE_TTL_DOCTOR=300
CACHE_TTL_SLOTS=60

# ============================================
# Rate limiting
# ============================================
# Format: <requests>/<period_in_seconds>
RATE_LIMIT_AUTH=5/60
RATE_LIMIT_APPOINTMENTS=10/60

# ============================================
# Business rules
# ============================================
# Minimum hours before appointment when cancellation is still allowed
CANCELLATION_MIN_HOURS=2
# Maximum number of active appointments per patient
MAX_ACTIVE_APPOINTMENTS=5

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
